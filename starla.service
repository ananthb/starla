[Unit]
Description=Starla RIPE Atlas Software Probe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/starla --config /etc/starla/config.toml
Restart=on-failure
RestartSec=10

# Scheduler bursts past the 1024 default under load.
LimitNOFILE=4096

DynamicUser=true
ConfigurationDirectory=starla
# 0755, not 0750: systemd never re-owns a configuration directory, so it
# stays root:root and a 0750 one is closed to the DynamicUser -- which then
# could not read config.toml. The file holds no secret (the key lives in the
# state directory or arrives as a credential).
ConfigurationDirectoryMode=0755
StateDirectory=starla
StateDirectoryMode=0750
RuntimeDirectory=starla
RuntimeDirectoryMode=0750

AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectClock=true
ProtectHostname=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# One list per line: systemd honours "~" only as the first character of a
# line, so "~@privileged" in the middle of the allow list was ignored (with a
# warning) and "@raw-io" joined the allow list. Raw sockets need neither
# @raw-io (that is ioperm/iopl) nor anything in @privileged; Starla never
# calls capset.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=multi-user.target

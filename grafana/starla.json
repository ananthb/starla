{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "options": { "0": { "text": "Disconnected", "color": "red" }, "1": { "text": "Connected", "color": "green" } }, "type": "value" }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Controller",
      "type": "stat",
      "targets": [{ "expr": "starla_controller_connected", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Queue Depth",
      "type": "stat",
      "targets": [{ "expr": "starla_upload_queue_depth", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Scheduled Tasks",
      "type": "stat",
      "targets": [{ "expr": "starla_scheduler_tasks_active", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Connection Attempts",
      "type": "stat",
      "targets": [{ "expr": "starla_connection_attempts_total", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Dropped Results",
      "type": "stat",
      "targets": [{ "expr": "starla_queue_dropped_total", "refId": "A" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "title": "Measurements",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "options": { "legend": { "calcs": ["rate"], "displayMode": "table" } },
      "title": "Measurements Started (rate)",
      "type": "timeseries",
      "targets": [{ "expr": "rate(starla_measurements_started_total[5m])", "legendFormat": "{{type}}", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "options": { "legend": { "calcs": ["rate"], "displayMode": "table" } },
      "title": "Measurement Failures (rate)",
      "type": "timeseries",
      "targets": [{ "expr": "rate(starla_measurements_failed_total[5m])", "legendFormat": "{{type}}", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "options": { "legend": { "calcs": ["p50", "p95", "p99"], "displayMode": "table" } },
      "title": "Measurement Duration",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.5, rate(starla_measurement_duration_seconds_bucket[5m]))", "legendFormat": "p50 {{type}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, rate(starla_measurement_duration_seconds_bucket[5m]))", "legendFormat": "p95 {{type}}", "refId": "B" },
        { "expr": "histogram_quantile(0.99, rate(starla_measurement_duration_seconds_bucket[5m]))", "legendFormat": "p99 {{type}}", "refId": "C" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "title": "Uploads",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 20 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "title": "Upload Rate",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(starla_upload_success_total[5m])", "legendFormat": "success", "refId": "A" },
        { "expr": "rate(starla_upload_failures_total[5m])", "legendFormat": "failure", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "title": "Queue Depth",
      "type": "timeseries",
      "targets": [{ "expr": "starla_upload_queue_depth", "legendFormat": "depth", "refId": "A" }]
    }
  ],
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "default", "value": "default" },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Starla RIPE Atlas Probe",
  "uid": "starla",
  "version": 1
}

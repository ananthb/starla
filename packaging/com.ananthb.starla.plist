<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ananthb.starla</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Starla Tray.app/Contents/MacOS/starla</string>
    <string>--config</string>
    <string>HOME_DIR/.config/starla/config.toml</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardErrorPath</key>
  <string>HOME_DIR/Library/Logs/starla.log</string>
  <key>StandardOutPath</key>
  <string>HOME_DIR/Library/Logs/starla.log</string>
</dict>
</plist>
